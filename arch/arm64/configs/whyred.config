# Xiaomi whyred (SDM636) fragment — apply on top of a Qualcomm/arm64 base config.
# No whyred camera VIDEO_* options.

CONFIG_LOCALVERSION="-whyred"

# Boot / EFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=y

# Display
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_SHENCHAO_TD4310=m
CONFIG_DRM_PANEL_TIANMA_TD4310=m
CONFIG_FB_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=m

# Touch
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_F11=y
CONFIG_RMI4_2D_SENSOR=y

# Audio
CONFIG_SND_SOC_SDM660_INT=m
CONFIG_SND_SOC_TAS2557=m
CONFIG_SND_SOC_MSM8916_WCD_ANALOG=m
CONFIG_SND_SOC_MSM8916_WCD_DIGITAL=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=m

# Power
CONFIG_BATTERY_PMI8998_FG=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
CONFIG_CHARGER_QCOM_SMB2=m

# Connectivity / modem
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT_QCOMSMD=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_APR=m

# IPA v2.6L (BAM) — from SirSireesh/msm8953 mainline-style port, not GSI msm8998
CONFIG_QCOM_BAM_DMA=m
CONFIG_QCOM_IPA=m
CONFIG_INTERCONNECT=y
CONFIG_QCOM_QMI_HELPERS=m
